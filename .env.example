PORT=4175
PUBLIC_SITE_URL=https://lovely-locs-booking.onrender.com
DATA_DIR=

# Lovely Locs owner notifications
BOOKING_OWNER_EMAIL=lvlc.support@lovelylocsnc.com
BOOKING_OWNER_PHONE=3364711098

# Manual deposit options
VENMO_HANDLE=
APPLE_PAY_CONTACT=
MANUAL_DEPOSIT_CONFIRM_TOKEN=

# Optional Stripe legacy/fallback deposits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email confirmations through Resend
# Create an API key at https://resend.com and use a verified sender/domain.
RESEND_API_KEY=
CONFIRMATION_FROM_EMAIL=Lovely Locs <lvlc.support@lovelylocsnc.com>
# Set this to true only after the Resend Domains dashboard shows the sending domain as verified.
RESEND_DOMAIN_VERIFIED=false
# Create a signed webhook for /api/resend/webhook and save its whsec_ value here.
RESEND_WEBHOOK_SECRET=

# Text confirmations through Twilio
# Create these in your Twilio dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# If TWILIO_FROM_NUMBER is a U.S. toll-free number, leave this false until Twilio shows it as fully verified.
# The app skips toll-free SMS while false so blocked messages do not keep using Twilio credit.
TWILIO_TOLLFREE_VERIFIED=false

# Automated reminders and marketing sends
# Use this token when calling /api/automations/run from Render Cron, UptimeRobot, Zapier, or another scheduler.
AUTOMATION_RUN_TOKEN=
# Optional: run daily automations from the web server process. A scheduled external call is still more reliable.
AUTOMATION_AUTO_RUN=false
# Optional: direct review requests somewhere specific, such as a Google review link.
REVIEW_REQUEST_URL=
# Referral and annual birthday credit amounts.
REFERRAL_CREDIT_AMOUNT=15
BIRTHDAY_CREDIT_AMOUNT=15
# Optional Google sign-in setup. Add a Google OAuth Web Client ID before enabling the Gmail button.
GOOGLE_CLIENT_ID=
# Optional: override the monthly referral campaign sent by /api/automations/run?type=monthly.
REFERRAL_CAMPAIGN_SUBJECT=Good People Know Good People
REFERRAL_CAMPAIGN_MESSAGE=
